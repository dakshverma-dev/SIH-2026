# Supabase project connection (get these from your Supabase project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: enables real LLM-based extraction via Anthropic API.
# Without this, the app runs on a deterministic DEMO_FALLBACK extractor
# (clearly labelled everywhere in the UI/audit trail — never presented as AI).
ANTHROPIC_API_KEY=

# SECURITY: set to "true" ONLY for judged/offline demos where a live Supabase
# auth connection is unavailable. Enables the hardcoded demo-account login
# fallback (see app/api/auth/login/route.ts). Leave unset in any real
# deployment — the fallback is fully disabled by default.
P2R_DEMO_LOGIN=false
