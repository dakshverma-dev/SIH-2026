[Unit]
Description=Plan2Reality Capture and Understand API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/sih-seeker/backend
EnvironmentFile=/home/ubuntu/sih-seeker/backend/.env
ExecStart=/home/ubuntu/sih-seeker/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8107
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
